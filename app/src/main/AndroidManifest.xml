<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Modul Pertemuan 4 bagian A - Modifikasi Permissions.
        Aplikasi berjalan di dalam sandbox dan tidak bisa membaca galeri foto
        tanpa izin. READ_MEDIA_IMAGES dipakai sejak Android 13 (API 33);
        READ_EXTERNAL_STORAGE dibatasi maxSdkVersion 32 karena izin itu sudah
        tidak berlaku di Android 13 ke atas.
    -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Jualan">
        <!--
            Modul Pertemuan 3 bagian I.4: intent-filter LAUNCHER dihapus dari
            MainActivity supaya tidak ada dua pintu masuk aplikasi.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Jualan"
            android:windowSoftInputMode="adjustResize" />

        <!--
            Launcher Activity baru. android:label sengaja tidak ditulis:
            tanpa label, Android memakai label <application> ("Jualan") untuk
            nama di bawah ikon aplikasi, bukan "HomeActivity".
        -->
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:theme="@style/Theme.Jualan"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>